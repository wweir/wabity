{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Wabity",
	"version": "0.1.0",
	"identifier": "com.wabity",
	"build": {
		"beforeDevCommand": "bash ./scripts/start-dev-server.sh",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Wabity",
				"width": 768,
				"height": 280,
				"center": false,
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"resizable": false,
				"fullscreen": false,
				"visible": false,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"windowEffects": null
			},
			{
				"label": "clipboard",
				"title": "Wabity Clipboard",
				"width": 452,
				"height": 408,
				"center": false,
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"resizable": false,
				"fullscreen": false,
				"visible": false,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"windowEffects": null
			}
		],
		"security": {
			"csp": null
		},
		"macOSPrivateApi": true
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
