{
	"name": "wabity",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 1420",
		"build": "tsc && vite build",
		"clean:target": "bash ./scripts/clean-target.sh",
		"clean:target:debug-cache": "bash ./scripts/clean-target.sh --scope debug-cache --hours 4",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"preview": "vite preview",
		"test": "node --test --experimental-strip-types scripts/*.test.mjs",
		"tauri": "bash ./scripts/tauri-cli.sh",
		"tauri:dev": "bash ./scripts/tauri-cli.sh dev",
		"tauri:build": "tauri build",
		"tauri:build:macos:dmg": "bash ./scripts/tauri-build-macos-dmg.sh"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"mermaid": "^11.16.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@tauri-apps/cli": "^2.11.4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.7.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.7.0",
		"prettier": "^3.9.3",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^7.3.6"
	}
}
